# Paperclip pilot: everything a human has to supply, in one place.
#
#   cp ops/paperclip/pilot.env.example ops/paperclip/pilot.env
#   chmod 600 ops/paperclip/pilot.env
#
# pilot.env is gitignored. Never commit it. The plan tasks source it on the Mac
# and push secret values into Paperclip's secret store on the box, then delete
# the copy on the box. Empty values here are placeholders, not defaults.

# ── Hetzner (Task 1) ───────────────────────────────────────────────────────
# The API token is NOT here; it lives in `hcloud context create nodeai`.
# These are choices. Read HETZNER_SERVER_TYPE off the Command Center box with
# `hcloud server list -o columns=name,type` and use the same type.
HETZNER_SERVER_TYPE=
HETZNER_LOCATION=hel1
HETZNER_SERVER_NAME=paperclip-pilot
HETZNER_SSH_KEY_NAME=cristoforo

# ── Tailscale (Task 2) ─────────────────────────────────────────────────────
# Approved in the browser, nothing to enter. The box's tailnet IP is written
# to TSIP below by Task 2 step 2.
TSIP=

# ── Paperclip (Task 4) ─────────────────────────────────────────────────────
# Exact commit to install. Get it with:
#   gh api repos/paperclipai/paperclip/commits/master --jq .sha
PAPERCLIP_COMMIT=

# ── GitHub (Task 7) ────────────────────────────────────────────────────────
# Fine-grained personal access token scoped to Node-AI-Studio/FounderOS only.
# Permissions: Contents read+write, Pull requests read+write, Metadata read.
# Expiry: 30 days. Stored in Paperclip as secret `github-founderos`.
GH_PAT=

# ── OpenAI (Task 10) ───────────────────────────────────────────────────────
# Used only by the reviewer agent, whose USD 5 cap is under test.
# Also set a USD 10 monthly limit on the OpenAI project as a backstop.
# Stored in Paperclip as secret `openai-reviewer`.
OPENAI_REVIEWER_KEY=

# ── Codex subscription (Task 9) ────────────────────────────────────────────
# Not an env var. `codex login --device-auth` on the box, approved from your
# phone. The credential lives in /home/paperclip/.codex/auth.json only.

# ── Written by the plan, not by you ────────────────────────────────────────
# COMPANY_ID, GOAL_ID, PROJECT_ID, GH_SECRET_ID, OPENAI_SECRET_ID, CONSOLE_ID,
# TEST_ID, REVIEWER_ID, ROUTINE_ID, ISO_ID land in ~/pilot.env on the box as
# tasks create them. Nothing to enter.
